#!/bin/bash

VLLM_PID=
LOGFILE=
CURRENT_MODEL=
VLLM_URL=${VLLM_URL:-http://localhost:8000}

get_model_id_from_file() {
	awk '{for(i=1;i<=NF;i++) if($i=="serve") {print $(i+1); exit}}' "$1"
}

get_running_model_id() {
	curl -s --max-time 2 "$VLLM_URL/v1/models" 2>/dev/null | \
		python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
    print(d["data"][0]["id"])
except Exception:
    pass' 2>/dev/null
}

start_server() {
	local name=$1
	local desired_id=$(get_model_id_from_file "./$name")
	local running_id=$(get_running_model_id)

	if test -n "$running_id" && test "$running_id" = "$desired_id"; then
		echo "vllm already serving $running_id, reusing"
		CURRENT_MODEL=$name
		if test -z "$VLLM_PID"; then
			VLLM_PID=$(pgrep -f "vllm serve $desired_id" | head -1)
		fi
		return 0
	fi
	stop_server
	LOGFILE=${name}.log
	rm -f $LOGFILE
	echo "starting vllm for $name (log: $LOGFILE)"
	bash ./$name > $LOGFILE 2>&1 &
	VLLM_PID=$!
	CURRENT_MODEL=$name

	while true; do
		sleep 1
		if ! kill -0 $VLLM_PID 2>/dev/null; then
			echo "ERROR: vllm process exited unexpectedly for $name"
			echo "--- $LOGFILE ---"
			cat $LOGFILE
			exit 1
		fi
		if grep -q "Application startup complete" $LOGFILE; then
			echo "vllm server ready for $name"
			return 0
		fi
		if grep -E -i -q "error|traceback|exception|failed" $LOGFILE; then
			echo "ERROR: vllm reported an error for $name"
			echo "--- $LOGFILE ---"
			cat $LOGFILE
			stop_server
			exit 1
		fi
	done
}

stop_server() {
	if test -z "$VLLM_PID"; then
		VLLM_PID=$(pgrep -f "vllm serve" | head -1)
	fi
	if test -n "$VLLM_PID" && kill -0 $VLLM_PID 2>/dev/null; then
		echo "stopping vllm (pid $VLLM_PID)"
		pkill -P $VLLM_PID 2>/dev/null
		kill $VLLM_PID 2>/dev/null
		wait $VLLM_PID 2>/dev/null
		pkill -f "vllm serve" 2>/dev/null
		while pgrep -f "vllm serve" >/dev/null 2>&1; do
			sleep 1
		done
	fi

	# vllm worker processes often reparent to init and survive the parent
	# kill -- hunt them down explicitly and SIGKILL
	local workers
	workers=$(pgrep -f "VLLM::Worker")
	if test -n "$workers"; then
		echo "killing orphan vllm workers: $workers"
		kill -9 $workers 2>/dev/null
		local tries=0
		while pgrep -f "VLLM::Worker" >/dev/null 2>&1; do
			tries=$((tries+1))
			if test $tries -gt 30; then
				echo "WARNING: vllm workers still alive after 30s: $(pgrep -f VLLM::Worker)"
				break
			fi
			pkill -9 -f "VLLM::Worker" 2>/dev/null
			sleep 1
		done
	fi

	VLLM_PID=
	CURRENT_MODEL=
}

do_bench() {
	local name=$1
	echo "running bench for $name"
	/src/shepherd/scripts/openai_bench.py > ${name}.bench
}

do_test() {
	local name=$1
	echo "running test for $name"
	/src/shepherd/scripts/test_model.py --benchmark mmlu --count 100 > ${name}.test
}

for i in *
do
	test `echo $i | grep -c -e '.test' -e '.bench' -e '.log'` -gt 0 && continue
	test "$i" = "doit" && continue
	test "$i" = "*" && continue
	echo $i
	if test -f ${i}.test; then
		_do_test=0
	else
		_do_test=1
	fi
	if test -f ${i}.bench; then
		_do_bench=0
	else
		_do_bench=1
	fi

	echo $_do_test $_do_bench
	if test $_do_test -gt 0 -o $_do_bench -gt 0; then
		start_server $i
		test $_do_test -gt 0 && do_test $i
		test $_do_bench -gt 0 && do_bench $i
	fi
done
